# Zugangsdaten des Supabase-Projekts.
# Beide Werte sind oeffentlich — sie stecken in jedem ausgelieferten Bundle.
# Die Absicherung leistet ausschliesslich Row Level Security in der Datenbank
# (siehe supabase/migrations und supabase/tests/rls-nachweis.sql).
#
# Ohne diese Werte startet die Anwendung trotzdem; der Konto-Bereich blendet
# sich dann aus und alles bleibt im localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
