{
  "name": "@renten/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run && npm run build && node --test \"test-node/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@renten/schema": "workspace:*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vite": "^6.0.5"
  }
}
